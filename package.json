{
  "name": "parkhill-bailey-wedding",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/gen-content.ts",
    "gen:gallery": "tsx scripts/gen-gallery.ts",
    "predev": "pnpm gen",
    "dev": "vite",
    "prebuild": "pnpm gen",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && node -e \"require('node:fs').rmSync('dist/parkhill_bailey_wedding/.dev.vars', { force: true })\" && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply wedding --local",
    "db:migrate:remote": "wrangler d1 migrations apply wedding --remote",
    "seed:guests": "tsx scripts/seed-guests.ts",
    "seed:registry": "tsx scripts/seed-registry.ts",
    "test": "pnpm gen && vitest run",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource/playfair-display-sc": "5.3.0",
    "@fontsource/unifrakturmaguntia": "5.3.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.14.0"
}
