{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "react", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-relative-parent-imports": "error",
    "max-lines-per-function": [
      "warn",
      { "max": 100, "skipBlankLines": true, "skipComments": true }
    ],
    "complexity": ["warn", 8],
    "max-params": ["warn", 5],
    // Off: written for the classic JSX transform. tsconfig uses "jsx": "react-jsx", which
    // imports the runtime automatically, so React never needs to be in scope.
    "react/react-in-jsx-scope": "off",
    // Stylesheets are imported for their side effect; Vite bundles them.
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "ignorePatterns": ["dist", ".wrangler", "node_modules", "content/details.json"]
}
